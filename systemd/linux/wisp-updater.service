[Unit]
Description=Wisp — Updater (atomic swap to a staged release)
After=network.target

[Service]
Type=oneshot
User=root
Environment=WISP_INSTALL_DIR=WISP_PATH
ExecStart=/usr/local/bin/wisp-updater
StandardOutput=journal
StandardError=journal
# Bounds the whole update run (stop, snapshot, swap, setup, start); typical runs
# finish in a few minutes. A backstop only: the steps carry their own bounds,
# which fire first. On expiry systemd sends TERM to wisp-updater alone (KillMode=mixed)
# and it rolls back; TimeoutStopSec is the time that gets before SIGKILL, which
# would leave a half-restored tree: at least the worst case of a stopped update,
# which scripts/check-bounds.mjs sums and checks. A later release never lowers
# either value (docs/specs/UPDATES.md).
TimeoutStartSec=1800
TimeoutStopSec=2200
KillMode=mixed
