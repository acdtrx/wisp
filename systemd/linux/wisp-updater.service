[Unit]
Description=Wisp — Updater (atomic swap to a staged release)
After=network.target

[Service]
Type=oneshot
User=root
Environment=WISP_INSTALL_DIR=WISP_PATH
ExecStart=/usr/local/bin/wisp-updater
StandardOutput=journal
StandardError=journal
# Bounds the whole update run (stop, snapshot, swap, setup, start); typical runs
# finish in a few minutes. A backstop only: the steps carry their own bounds
# (setup's npm ci 10 min without output, its package lock wait 5 min), which
# fire first. On expiry systemd sends TERM to wisp-updater alone (KillMode=mixed)
# and it rolls back; TimeoutStopSec is the time that gets before SIGKILL, which
# would leave a half-restored tree. wisp-updater adds up its bounds inside it
# (1030 s); a later release never lowers either value — the updater that runs
# is the previous release's, under this file's limits.
TimeoutStartSec=1800
TimeoutStopSec=1140
KillMode=mixed
