[Unit]
Description=Wisp — Updater (atomic swap to a staged release)
After=network.target

[Service]
Type=oneshot
User=root
Environment=WISP_INSTALL_DIR=WISP_PATH
ExecStart=/usr/local/bin/wisp-updater
StandardOutput=journal
StandardError=journal
# Bounds the whole update run (stop, snapshot, swap, setup, start); typical runs
# finish in a few minutes. A backstop only: the steps carry their own bounds
# (setup's npm ci 10 min without output, its package lock wait 5 min), which
# fire first. On expiry systemd SIGTERMs the unit and wisp-updater rolls back;
# TimeoutStopSec is the time that rollback gets before systemd escalates to
# SIGKILL, which would leave a half-restored tree: wisp-updater bounds its own
# parts to 15 s + 120 s + 300 s + 120 s inside it.
TimeoutStartSec=1800
TimeoutStopSec=600
