[Unit]
Description=Wisp — Updater (atomic swap to a staged release)
After=network.target

[Service]
Type=oneshot
User=root
Environment=WISP_INSTALL_DIR=WISP_PATH
ExecStart=/usr/local/bin/wisp-updater
StandardOutput=journal
StandardError=journal
# Bounds the whole update run (stop, snapshot, swap, npm ci, common-steps,
# start); typical runs finish in a few minutes. On expiry systemd SIGTERMs the
# unit and wisp-updater rolls back; TimeoutStopSec is the time that rollback gets
# before systemd escalates to SIGKILL, which would leave a half-restored tree.
TimeoutStartSec=600
TimeoutStopSec=300
