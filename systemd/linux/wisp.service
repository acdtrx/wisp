[Unit]
Description=Wisp
After=network-online.target libvirtd.service virtqemud.service containerd.service
Wants=network-online.target

[Service]
User=WISP_USER
WorkingDirectory=WISP_PATH/backend
EnvironmentFile=-WISP_PATH/config/runtime.env
# Ensure the mDNS stub IP (169.254.53.53) exists on wisp-dns0 before the
# in-process DNS forwarder (backend/src/lib/mdns/linux/forwarder.js) binds to
# it — a failed bind disables container DNS for the whole life of the process.
# systemd-networkd normally owns both the interface and the address (declared by
# container-dns.sh in 10-wisp-dns0.netdev/.network); this covers hosts networkd
# does not manage. The address deliberately does NOT live on br0: see the header
# of container-dns.sh for the two ways that failed. `+` runs this as root even
# though the main service runs as WISP_USER; trailing `exit 0` so a failure here
# degrades container DNS rather than blocking startup.
ExecStartPre=+/bin/sh -c 'ip link show wisp-dns0 >/dev/null 2>&1 || ip link add wisp-dns0 type dummy; ip link set wisp-dns0 up; ip -4 addr show dev wisp-dns0 | grep -q "169.254.53.53/32" || ip addr add 169.254.53.53/32 dev wisp-dns0; exit 0'
ExecStart=/usr/bin/node src/index.js
# Grant CAP_NET_BIND_SERVICE so mdnsForwarder can bind UDP+TCP 169.254.53.53:53
# while the service otherwise runs unprivileged as WISP_USER. Do NOT also set
# CapabilityBoundingSet — it would cap every child process (including sudo)
# to just this one capability, and sudo needs CAP_SETUID/CAP_SETGID to elevate,
# which breaks the wisp-netns and wisp-mount privileged helpers.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
