# Optional. If missing, Wisp uses built-in defaults (port 8080).
# Copy to runtime.env and edit if you need a non-default port or bridge override.

# WISP_PORT=8080

# Optional: default bridge for new VM NICs (auto-detected if unset)
# WISP_DEFAULT_BRIDGE=br0

# Optional: containerd's socket
# WISP_CONTAINERD_SOCK=/run/containerd/containerd.sock

# Optional: other origins a browser may open the WebSocket consoles from,
# comma-separated (unset: the page's own origin only)
# WISP_ALLOWED_WS_ORIGINS=https://wisp.example.com

# Optional: the GitHub repository Wisp's updates come from (owner/name)
# WISP_UPDATE_REPO=acdtrx/wisp

# Optional: GitHub API token for some download flows (dev/advanced)
# GITHUB_TOKEN=
