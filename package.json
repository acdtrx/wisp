{
  "name": "wisp",
  "version": "2.8.0-beta.1",
  "private": true,
  "description": "Wisp — VM and container management",
  "scripts": {
    "release": "bash scripts/release.sh",
    "check": "node scripts/check.mjs",
    "test": "node --test --experimental-test-module-mocks --test-timeout=10000 'frontend/src/**/*.test.js' 'backend/src/**/*.test.js'",
    "lint": "eslint --max-warnings 0 backend frontend/src",
    "check-imports": "node scripts/check-imports.mjs",
    "check-fences": "node scripts/check-fences.mjs",
    "route-access": "WISP_ROUTE_ACCESS_REPORT=1 node backend/src/index.js"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0"
  }
}
