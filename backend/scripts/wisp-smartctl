#!/usr/bin/env bash
# Usage: wisp-smartctl <block-device-name>      (e.g. sda, nvme0n1)
# The disk's SMART data: smartctl's own JSON on stdout, whatever its exit
# status (a bitmask of the disk's state, not of the read). A disk in standby is
# never woken: the answer is then exactly {"standby":true}.
# shellcheck source=wisp-helper-lib.sh
source "${BASH_SOURCE[0]%/*}/wisp-helper-lib.sh"

# smartctl on a disk that hangs, and on a large SCSI log, takes a few seconds.
readonly SMART_SEC=20

(( $# == 1 )) || refuse "usage: wisp-smartctl <block-device-name>"
match "the disk" "$1" '^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$'
DEV_PATH="/dev/$1"
[[ -b "$DEV_PATH" ]] || not_found "$DEV_PATH is not a block device"

# `-n standby,STATUS` makes smartctl exit before any SMART command when the
# drive is in STANDBY or SLEEP, with exit status STATUS. 130 = bit 1 (aborted
# before reading SMART data) + bit 7 (self-test log has errors, which needs
# SMART data read): a combination no real run produces. NVMe is excluded: the
# option is ATA/SCSI-only and NVMe drives do not spin.
readonly STANDBY_EXIT=130
POWER_ARGS=()
[[ "$1" == nvme* ]] || POWER_ARGS=(-n "standby,$STANDBY_EXIT")

rc=0
capture "$SMART_SEC" smartctl --json ${POWER_ARGS[@]+"${POWER_ARGS[@]}"} -a "$DEV_PATH" || rc=$?
(( rc == 124 )) && fail "smartctl did not finish within ${SMART_SEC} s"
(( rc == 127 )) && fail "smartctl is not installed: run setup"
if (( ${#POWER_ARGS[@]} > 0 && rc == STANDBY_EXIT )); then
  echo '{"standby":true}'
  exit 0
fi
[[ -n "$CAPTURED" ]] || fail "smartctl printed nothing (exit $rc)${BOUNDED_ERR:+: $BOUNDED_ERR}"
printf '%s\n' "$CAPTURED"
