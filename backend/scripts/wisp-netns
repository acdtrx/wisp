#!/usr/bin/env bash
# Usage:
#   wisp-netns add <container>                       # ensure /var/run/netns/<container>
#   wisp-netns delete <container>                    # exit 2 when there is none
#   wisp-netns route-add <container> <ifname> <ipv4> # an on-link /32 in its netns
#
# A container's network namespace, named after the container, so it is always
# one of Wisp's own under /var/run/netns. route-add puts the container DNS
# stub's address on the container's veth (docs/specs/CONTAINERS.md, Local DNS).
# shellcheck source=wisp-helper-lib.sh
source "${BASH_SOURCE[0]%/*}/wisp-helper-lib.sh"

readonly NETNS_DIR=/var/run/netns

usage="usage: wisp-netns add|delete <container> | route-add <container> <ifname> <ipv4>"
(( $# >= 2 )) || refuse "$usage"
match_one_of "the action" "$1" add delete route-add
match_name "the container" "$2"
NAME="$2"
case "$1" in
  add | delete) (( $# == 2 )) || refuse "$usage" ;;
  route-add)
    (( $# == 4 )) || refuse "$usage"
    match "the interface" "$3" "$IFACE_RE"
    match "the address" "$4" '^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$'
    for octet in "${BASH_REMATCH[@]:1}"; do
      (( 10#$octet <= 255 )) || refuse "the address is not valid: '$4'"
    done
    ;;
esac

case "$1" in
  add)
    [[ ! -e "$NETNS_DIR/$NAME" ]] || exit 0
    must "$QUICK_SEC" mkdir -p -- "$NETNS_DIR"
    must "$QUICK_SEC" ip netns add "$NAME"
    must "$QUICK_SEC" ip netns exec "$NAME" ip link set lo up
    ;;
  delete)
    [[ -e "$NETNS_DIR/$NAME" ]] || not_found "no network namespace $NAME"
    must "$QUICK_SEC" ip netns delete "$NAME"
    ;;
  route-add)
    [[ -e "$NETNS_DIR/$NAME" ]] || not_found "no network namespace $NAME"
    must "$QUICK_SEC" ip -n "$NAME" route replace "$4/32" dev "$3"
    ;;
esac
