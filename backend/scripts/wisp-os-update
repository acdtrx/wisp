#!/usr/bin/env bash
# Usage: wisp-os-update list | upgrade
#   list    - sync the package database, then the packages an upgrade would
#             change, on stdout:
#               PKG<TAB>name<TAB>from<TAB>to     (one line per package, "from" empty for new installs)
#               TOTAL <bytes>                    (estimated download size; 0 if unknown)
#   upgrade - sync the package database and perform a full upgrade (non-interactive).
#             Debian uses dist-upgrade so kept-back packages needing new deps
#             (kernel-meta jumps etc.) install too; list simulates the same
#             action so the list matches what upgrade will do.
# Non-interactive by construction: nothing may prompt, because the caller is a
# backend with no terminal and a prompt is a hang until a bound kills the
# package manager mid-run. Locally modified config files are always kept
# (--force-confold).
#
# Progress: the package manager's output, passed through on stderr (the
# backend's progress signal); the error line, when there is one, comes last.
# Exit 75 when another apt/dpkg process holds the package manager's lock.
# shellcheck source=wisp-helper-lib.sh
source "${BASH_SOURCE[0]%/*}/wisp-helper-lib.sh"

(( $# == 1 )) || refuse "usage: wisp-os-update list|upgrade"
match_one_of "the action" "$1" list upgrade
CMD="$1"

# Pattern matched against apt/dpkg output to identify lock-contention errors.
LOCK_PATTERN='Could not get lock|Could not open lock|Unable to (acquire|lock)|Resource temporarily unavailable|already locked|frontend is locked'

# Bounds (CODING-RULES §6; the values are contracts in docs/specs/HOST-MONITORING.md
# § OS Updates). Every package-manager step passes its output through to stderr
# and keeps a copy for lock detection. A step that shows progress is stopped
# here after a time without output, so a hung one is killed rather than
# orphaned holding the lock: the index refresh after REFRESH_IDLE seconds, the
# upgrade after UPGRADE_IDLE (dkms and initramfs builds can be silent for
# minutes). The simulated upgrade prints nothing until it ends, so it gets a
# fixed SIMULATE_TIMEOUT. A TERM reaching this script (the backend's own,
# outer bound, or its stop) stops the running step's child with it.
REFRESH_IDLE=60
SIMULATE_TIMEOUT=60
UPGRADE_IDLE=900

RUN_LOG="$(mktemp -t wisp-os-update-log.XXXXXX)"
CHILD_PID=""
cleanup() {
  rm -f -- "$RUN_LOG"
}
trap cleanup EXIT
stop_child() {
  if [[ -n "$CHILD_PID" ]]; then
    kill -TERM "$CHILD_PID" 2>/dev/null || true
    sleep 5
    kill -KILL "$CHILD_PID" 2>/dev/null || true
  fi
  exit 143
}
trap stop_child TERM INT

# idle_run SECS cmd...: run cmd with its stdout and stderr passed through to our
# stderr and copied into $RUN_LOG; killed after SECS seconds without a line of
# output (exit 124). Returns cmd's exit status.
idle_run() {
  local secs="$1"; shift
  local fifo fd line r rc=0 timed_out=0
  : > "$RUN_LOG"
  fifo="$(mktemp -u -t wisp-os-update-fifo.XXXXXX)"
  mkfifo -m 600 "$fifo"
  "$@" > "$fifo" 2>&1 &
  CHILD_PID=$!
  exec {fd}< "$fifo"
  rm -f -- "$fifo"
  while :; do
    IFS= read -r -t "$secs" -u "$fd" line && r=0 || r=$?
    if (( r == 0 )); then
      printf '%s\n' "$line" >&2
      printf '%s\n' "$line" >> "$RUN_LOG"
      continue
    fi
    if (( r > 128 )); then
      timed_out=1
      kill -TERM "$CHILD_PID" 2>/dev/null || true
      sleep 5
      kill -KILL "$CHILD_PID" 2>/dev/null || true
    elif [[ -n "$line" ]]; then
      printf '%s\n' "$line" >&2
      printf '%s\n' "$line" >> "$RUN_LOG"
    fi
    break
  done
  exec {fd}<&-
  wait "$CHILD_PID" 2>/dev/null || rc=$?
  CHILD_PID=""
  (( timed_out )) && return 124
  return "$rc"
}

# run_step SECS cmd...: idle_run; a failure ends the helper: busy when the
# output names a held package-manager lock, else failed, each with its line.
run_step() {
  local secs="$1" rc=0
  idle_run "$@" || rc=$?
  (( rc == 0 )) && return 0
  grep -qE "$LOCK_PATTERN" "$RUN_LOG" && busy "another package manager holds the lock; try again later"
  (( rc == 124 )) && fail "$2 printed nothing for ${secs} s and was stopped"
  fail "$2 failed (exit $rc)"
}

# `apt-get -s dist-upgrade` output, into OUT (it may exit non-zero and still
# print what it would do; only a timeout is a failure).
simulate_dist_upgrade() {
  local rc=0
  capture "$SIMULATE_TIMEOUT" env LC_ALL=C apt-get -s dist-upgrade || rc=$?
  (( rc == 124 )) && fail "apt-get -s dist-upgrade did not finish within ${SIMULATE_TIMEOUT} s"
  OUT="$CAPTURED"
}

# sudo's env_reset drops the caller's environment, so these are set here.
# - DEBIAN_FRONTEND=noninteractive: debconf takes defaults instead of asking.
# - NEEDRESTART_MODE=a: Ubuntu's needrestart restarts affected services
#   itself instead of asking which ones to restart.
# - UCF_FORCE_CONFFOLD=1: ucf-managed config files (e.g. sshd_config) keep
#   the local version, matching --force-confold for dpkg conffiles below.
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export UCF_FORCE_CONFFOLD=1
case "$CMD" in
  list)
    run_step "$REFRESH_IDLE" apt-get update
    simulate_dist_upgrade
    # `Inst <name> [<from>] (<to> ...)` for upgrades; `Inst <name> (<to> ...)` for new pulls.
    echo "$OUT" | awk -v OFS='\t' '
      /^Inst / {
        name=$2; from=""; to="";
        if ($3 ~ /^\[/) {
          from=$3; sub(/^\[/, "", from); sub(/\]$/, "", from);
          to=$4;   sub(/^\(/, "", to);
        } else {
          to=$3;   sub(/^\(/, "", to);
        }
        printf "PKG%s%s%s%s%s%s\n", "\t", name, "\t", from, "\t", to;
      }
    '
    # apt prints "Need to get X[.Y] (kB|MB|GB|B) of archives." — convert to bytes.
    NEED=$(echo "$OUT" | grep -E '^Need to get ' | head -n1 || true)
    BYTES=0
    if [[ -n "$NEED" ]]; then
      AMOUNT=$(echo "$NEED" | awk '{print $4}')
      UNIT=$(echo "$NEED" | awk '{print $5}')
      case "$UNIT" in
        B)  BYTES=$(awk -v n="$AMOUNT" 'BEGIN{printf "%.0f", n}') ;;
        kB) BYTES=$(awk -v n="$AMOUNT" 'BEGIN{printf "%.0f", n*1000}') ;;
        MB) BYTES=$(awk -v n="$AMOUNT" 'BEGIN{printf "%.0f", n*1000*1000}') ;;
        GB) BYTES=$(awk -v n="$AMOUNT" 'BEGIN{printf "%.0f", n*1000*1000*1000}') ;;
      esac
    fi
    echo "TOTAL ${BYTES}"
    ;;
  upgrade)
    run_step "$REFRESH_IDLE" apt-get update
    # confdef+confold: an untouched conffile takes the package's new version,
    # a locally modified one is kept (the new one lands as .dpkg-dist).
    run_step "$UPGRADE_IDLE" apt-get -y \
      -o Dpkg::Options::=--force-confdef \
      -o Dpkg::Options::=--force-confold \
      dist-upgrade
    ;;
esac
