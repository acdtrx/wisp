#!/usr/bin/env bash
# Usage: wisp-nvram copy <src> <dst>
#
# A copy of a VM's UEFI NVRAM file (VARS.fd), owned by the invoking user. libvirt
# creates <vm-dir>/VARS.fd as libvirt-qemu:kvm, mode 600: the deploy user is in
# the kvm group, but mode 600 grants only the owner. Used by a VM's backup
# (src <vm-dir>/VARS.fd, dst <backup-dir>/VARS.fd) and its restore (the other
# way); libvirt's dynamic_ownership reclaims the file when the VM starts.
#
# Both paths: canonical, named VARS.fd, under /var/lib/wisp or /mnt/wisp, with
# no symbolic link below those. The copy is written beside dst and renamed over
# it, so a link put at dst is replaced, never written through.
# shellcheck source=wisp-helper-lib.sh
source "${BASH_SOURCE[0]%/*}/wisp-helper-lib.sh"

ROOTS=(/var/lib/wisp /mnt/wisp)
# A few MB, local or on a backup mount.
readonly COPY_SEC=30

(( $# == 3 )) || refuse "usage: wisp-nvram copy <src> <dst>"
match_one_of "the action" "$1" copy
SRC="$2"
DST="$3"
path_under "src" "$SRC" "${ROOTS[@]}"
path_under "dst" "$DST" "${ROOTS[@]}"
[[ "${SRC##*/}" == VARS.fd ]] || refuse "src must be named VARS.fd: '$SRC'"
[[ "${DST##*/}" == VARS.fd ]] || refuse "dst must be named VARS.fd: '$DST'"
invoking_user

[[ -f "$SRC" ]] || not_found "src is not there: $SRC"
DST_DIR="${DST%/*}"
[[ -d "$DST_DIR" ]] || not_found "the folder of dst is not there: $DST_DIR"

TMP=""
remove_tmp() { [[ -z "$TMP" ]] || bounded "$QUICK_SEC" rm -f -- "$TMP" || true; }
trap remove_tmp EXIT
capture "$QUICK_SEC" mktemp "$DST_DIR/.VARS.fd.wisp-new.XXXXXX" || fail "cannot create a file in $DST_DIR${BOUNDED_ERR:+: $BOUNDED_ERR}"
TMP="$CAPTURED"
must "$COPY_SEC" cp --preserve=mode,timestamps -- "$SRC" "$TMP"
must "$QUICK_SEC" chown -- "$INVOKER_UID:$INVOKER_GID" "$TMP"
must "$QUICK_SEC" mv -fT -- "$TMP" "$DST"
TMP=""
