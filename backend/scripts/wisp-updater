#!/usr/bin/env bash
# Atomic-swap update applier. Triggered as a systemd Type=oneshot unit
# (`wisp-updater.service`). Lives in its own cgroup with no inherited stdio,
# so wisp's death during step:stop-service can't reach in.
#
#   Backend writes the staging dir to /var/lib/wisp/updates/target and runs:
#     sudo -n systemctl start --no-block wisp-updater.service
#
# Steps (echoed to journald):
#   stop-service → snapshot → swap → setup → start-service → done
# setup is the install's setup (scripts/linux/setup/common-steps.sh from the
# swapped tree): it carries the backend's dependencies and wisp.service too.
# start-service is the health gate: wisp.service is Type=notify, so
# `systemctl start` returns once the new backend is ready (state migrations run,
# listening) and fails as soon as it exits first, a failed migration included.
#
# On any failure after `snapshot` — an unhealthy new backend included — rolls
# back from <install>.prev and exits non-zero.
# Rollback restores the tree; when setup had already run, it also runs the
# restored (old) tree's setup again, so helpers, sudoers, units and the backend's
# dependencies match the code that runs.
# User config (config/wisp-config.json, wisp-password, runtime.env), the backup
# status cache (config/backup-status.json), the state-migration ledger
# (config/migrations.json) and runtime scratch (.pids, .logs) survive the swap.
# config/ is where the config file, wisp-password and the ledger live by
# default: a WISP_CONFIG_PATH elsewhere puts the three outside the tree, where
# the swap never reaches, and a config/wisp-password an earlier release left
# there is kept for the new backend's migration 0010 to move.
# A rollback restores all of config/ from the snapshot, the ledger included: a
# migration the new backend ran may have changed config/, and the ledger must
# revert with it, so every such migration runs again on the next update — safe
# because migrations are idempotent.

set -uo pipefail

UPDATES_DIR=/var/lib/wisp/updates
TARGET_FILE="$UPDATES_DIR/target"
INSTALL_DIR="${WISP_INSTALL_DIR:-}"

fail() {
  echo "error: $*" >&2
  exit 1
}

[[ -n "$INSTALL_DIR" ]] || fail "WISP_INSTALL_DIR not set (unit file should template it)"
[[ "$INSTALL_DIR" == /* ]] || fail "install dir must be absolute: $INSTALL_DIR"
[[ -d "$INSTALL_DIR" ]] || fail "install dir not found: $INSTALL_DIR"
[[ -f "$TARGET_FILE" ]] || fail "no pending update: $TARGET_FILE missing"

STAGING_RAW="$(head -n 1 "$TARGET_FILE" | tr -d '[:space:]')"
[[ -n "$STAGING_RAW" ]] || fail "target file is empty"
[[ -d "$STAGING_RAW" ]] || fail "staging dir not found: $STAGING_RAW"
# Compare canonical paths: `..` segments or a symlinked staging-* entry must not
# lead the swap to a tree outside the updates dir. The updates dir itself is
# canonicalised too, so a host that symlinks /var/lib/wisp elsewhere still works.
UPDATES_REAL="$(realpath -e -- "$UPDATES_DIR")" || fail "cannot resolve $UPDATES_DIR"
STAGING="$(realpath -e -- "$STAGING_RAW")" || fail "cannot resolve staging path: $STAGING_RAW"
STAGING_PREFIX="$UPDATES_REAL/staging-"
[[ "$STAGING" == "$STAGING_PREFIX"* && "${STAGING#"$STAGING_PREFIX"}" != */* ]] \
  || fail "staging path outside $UPDATES_DIR/staging-*: $STAGING_RAW"
[[ "$STAGING" != "$INSTALL_DIR" ]] || fail "staging and install dir must differ"
[[ -f "$STAGING/backend/package.json" ]] || fail "staging dir does not look like a wisp tree"

# Detect deploy user and group from the owner of the install dir (copy.sh sets
# it to the installing user and their primary group, which need not share the
# user's name).
DEPLOY_USER="$(stat -c %U "$INSTALL_DIR")"
[[ -n "$DEPLOY_USER" && "$DEPLOY_USER" != "root" ]] || fail "could not detect non-root deploy user from $INSTALL_DIR"
DEPLOY_OWNER="$(stat -c %U:%G "$INSTALL_DIR")"

PREV_DIR="${INSTALL_DIR}.prev"
SERVICE_UNIT=wisp

# The bounds. Each layer owns its own: the updater bounds what it runs itself;
# setup bounds its own steps and ends within its own stop bound once sent a TERM
# (scripts/linux/setup/bounds.sh), so the updater sends setup a TERM and waits,
# and never kills it. When the unit's start times out, systemd sends this script
# TERM (KillMode=mixed: this process only) and gives it TimeoutStopSec before
# SIGKILL: the stopped setup ending, then the rollback, each of its parts
# bounded here — stop wisp, restore the tree, the restored tree's setup (past
# its limit, a TERM, and setup's own stop bound again), daemon-reload, the
# start, the read of its state; a part that runs past its bound gets
# KILL_GRACE_SEC more to die. scripts/check-bounds.mjs (npm run check) sums the
# worst case from these numbers and setup's, and fails when the unit's
# TimeoutStopSec (systemd/linux/wisp-updater.service) is below it.
KILL_GRACE_SEC=10
STOP_WISP_SEC=40
ROLLBACK_RESTORE_SEC=120
ROLLBACK_SETUP_SEC=300
DAEMON_RELOAD_SEC=30
ROLLBACK_START_WAIT_SEC=120
STATUS_SEC=10
# The install lock another install, update or setup holds is waited for this
# long. Its path is setup's too (scripts/linux/setup/lib.sh, WISP_LOCK), kept
# the same by scripts/check-bounds.mjs: this script is installed on its own.
LOCK_WAIT_SEC=600
WISP_LOCK=/run/wisp.lock

# User-data and runtime scratch must survive the swap rsync.
RSYNC_EXCLUDES=(
  --exclude '/config/wisp-config.json'
  --exclude '/config/wisp-password'
  --exclude '/config/runtime.env'
  --exclude '/config/backup-status.json'
  --exclude '/config/migrations.json'
  --exclude '/.pids'
  --exclude '/.logs'
)

snapshot_taken=0
host_setup_touched=0

# One lock for anything that changes the installation, taken before the swap
# and handed to setup (fd 8).
exec 8> "$WISP_LOCK"
flock -w "$LOCK_WAIT_SEC" 8 || fail "another install, update or setup holds $WISP_LOCK; gave up after ${LOCK_WAIT_SEC} s"

# Every command that can take long runs through run_child: as the leader of a
# session of its own, in the background, so a TERM reaches this script at once
# and is passed on. A command that bounds itself (setup) is sent TERM alone and
# waited for. Any other is sent TERM in its whole session — timeout's process
# group too — given GRACE seconds to end, then its session is killed, and the
# wait lasts until the session is empty. A stop (before the rollback) then
# exits 143: the EXIT trap rolls back. A LIMIT (the rollback's parts) stops the
# command the same way after LIMIT seconds. The handler only records a stop
# when no command is known yet; the next command is not started.
STOPPING=0
CHILD=""
CHILD_GRACE=0
CHILD_OWN_BOUND=0
CHILD_STOPPER=""
# signal_later <secs> <sid> <TERM|KILL|SELF-TERM>: in the background, that
# signal to the session after <secs> (a TERM followed by KILL KILL_GRACE_SEC
# later; SELF-TERM, a TERM to the leader alone, for a command that bounds
# itself). Deaf to TERM and INT, so a stop sent to this script leaves it be;
# cancelled by USR1. Without the lock's descriptor, so one left behind holds no
# lock.
signal_later() {
  (
    exec 8>&-
    trap '' TERM INT
    trap 'kill -KILL $! 2>/dev/null; exit 0' USR1
    sleep "$1" & wait $!
    case "$3" in
      SELF-TERM) kill -TERM "$2" 2>/dev/null; exit 0 ;;
      KILL) pkill -KILL -s "$2" 2>/dev/null; exit 0 ;;
    esac
    pkill -TERM -s "$2" 2>/dev/null
    sleep "$KILL_GRACE_SEC" & wait $!
    pkill -KILL -s "$2" 2>/dev/null
  ) &
}
stop_child() {
  [[ -n "$CHILD" && -z "$CHILD_STOPPER" ]] || return 0
  if (( CHILD_OWN_BOUND )); then
    kill -TERM "$CHILD" 2>/dev/null
    return 0
  fi
  pkill -TERM -s "$CHILD" 2>/dev/null
  signal_later "$CHILD_GRACE" "$CHILD" KILL
  CHILD_STOPPER=$!
}
# run_child <limit, 0 for none> <grace on a stop, or own-bound> <cmd...>
run_child() {
  local limit="$1" pid rc limiter="" k
  CHILD_OWN_BOUND=0 CHILD_GRACE="$2"
  [[ "$2" != own-bound ]] || CHILD_OWN_BOUND=1 CHILD_GRACE=0
  shift 2
  (( STOPPING )) && exit 143
  setsid "$@" &
  pid=$!
  CHILD=$pid
  if (( limit > 0 )); then
    if (( CHILD_OWN_BOUND )); then signal_later "$limit" "$pid" SELF-TERM; else signal_later "$limit" "$pid" TERM; fi
    limiter=$!
  fi
  (( STOPPING )) && stop_child
  # wait returns early for a signal; the command is gone once kill -0 fails,
  # and what it started once its session is empty.
  while :; do
    rc=0
    wait "$pid" || rc=$?
    kill -0 "$pid" 2>/dev/null && continue
    pgrep -s "$pid" >/dev/null || break
    sleep 1
  done
  for k in $limiter $CHILD_STOPPER; do kill -USR1 "$k" 2>/dev/null; wait "$k" 2>/dev/null; done
  CHILD="" CHILD_STOPPER=""
  (( STOPPING )) && exit 143
  return "$rc"
}

# Runs from the EXIT trap, so it never calls fail/exit. Every step logs its own
# failure and the rollback carries on to the start — but for the restore of the
# tree: a tree not restored is neither set up nor started, part old and part
# new; the rollback ends there and names the manual finish. A rollback that
# cannot complete leaves `rollback-warning:` lines in the journal
# (docs/specs/UPDATES.md).
rollback() {
  echo "step:rollback"
  # After a failed start the new backend may be cycling through
  # Restart=on-failure: stop it before the tree is restored under it.
  run_child "$STOP_WISP_SEC" 0 systemctl stop "$SERVICE_UNIT" 2>/dev/null \
    || echo "rollback-warning: stopping $SERVICE_UNIT failed"
  if [[ "$snapshot_taken" -eq 1 && -d "$PREV_DIR" ]]; then
    # config/ and its ledger revert together: the migrations the new backend's
    # start ran run again at the next start of a release that ships them (they
    # are idempotent).
    if ! run_child "$ROLLBACK_RESTORE_SEC" 0 sh -c 'rsync -a --delete "$1/" "$2/" && chown -R "$3" "$2"' \
      restore "$PREV_DIR" "$INSTALL_DIR" "$DEPLOY_OWNER"; then
      echo "rollback-warning: the tree was not restored from $PREV_DIR, so it is neither set up nor started. Finish by hand, as root: rsync -a --delete $PREV_DIR/ $INSTALL_DIR/; chown -R $DEPLOY_OWNER $INSTALL_DIR; $INSTALL_DIR/scripts/linux/setup/common-steps.sh $INSTALL_DIR $DEPLOY_USER; systemctl start $SERVICE_UNIT"
      return
    fi
    if [[ "$host_setup_touched" -eq 1 ]]; then
      # The new release's helpers, sudoers and units may already be installed;
      # put back the restored tree's own. That tree is the release that
      # installed this updater, so its setup renders wisp.service too.
      echo "step:rollback-setup"
      local old_steps="$INSTALL_DIR/scripts/linux/setup/common-steps.sh"
      if [[ -x "$old_steps" ]]; then
        run_child "$ROLLBACK_SETUP_SEC" own-bound "$old_steps" "$INSTALL_DIR" "$DEPLOY_USER" \
          || echo "rollback-warning: the restored tree's setup failed or ran past ${ROLLBACK_SETUP_SEC}s: wisp.service and the helpers may still be the new release's"
      else
        echo "rollback-warning: $old_steps missing: wisp.service and the helpers may still be the new release's"
      fi
    fi
  fi
  run_child "$DAEMON_RELOAD_SEC" 0 systemctl daemon-reload || echo "rollback-warning: daemon-reload failed"
  # The restored release is what ran before, there is nothing further to fall
  # back to, and the rollback must end: its start gets a short wait, and a start
  # not done by then is reported, not retried. A wait cut short leaves the start
  # job to systemd.
  if ! run_child "$ROLLBACK_START_WAIT_SEC" 0 systemctl start "$SERVICE_UNIT"; then
    local state
    state="$(run_child "$STATUS_SEC" 0 systemctl show "$SERVICE_UNIT" -p ActiveState -p SubState --value | tr '\n' ' ')"
    echo "rollback-warning: the restored release did not start within ${ROLLBACK_START_WAIT_SEC}s (wisp.service: ${state:-unknown})"
  fi
}

# The EXIT trap first stops TERM and INT from cutting the rollback short: a
# no-op handler, not SIG_IGN, so the commands it runs keep the default and their
# bounds can still stop them; a stop that came before is done with.
trap 'rc=$?; trap ":" TERM INT; STOPPING=0; if [[ $rc -ne 0 ]]; then rollback; fi' EXIT
trap 'STOPPING=1; stop_child' TERM INT

echo "step:stop-service"
# A backend that does not stop fails the update before anything is changed.
run_child "$STOP_WISP_SEC" "$KILL_GRACE_SEC" systemctl stop "$SERVICE_UNIT" \
  || fail "$SERVICE_UNIT did not stop within ${STOP_WISP_SEC}s; nothing was changed"

echo "step:snapshot"
run_child 0 "$KILL_GRACE_SEC" rm -rf "$PREV_DIR" || fail "cannot remove the previous snapshot $PREV_DIR"
run_child 0 "$KILL_GRACE_SEC" rsync -a --delete "$INSTALL_DIR/" "$PREV_DIR/" || fail "snapshot rsync failed"
snapshot_taken=1

echo "step:swap"
run_child 0 "$KILL_GRACE_SEC" rsync -a --delete "${RSYNC_EXCLUDES[@]}" "$STAGING/" "$INSTALL_DIR/" || fail "swap rsync failed"
run_child 0 "$KILL_GRACE_SEC" chown -R "$DEPLOY_OWNER" "$INSTALL_DIR" || fail "chown failed"

echo "step:setup"
# The install's setup, by path from the freshly swapped tree, so the step list
# is whatever THIS release ships: a step added to setup takes effect on the very
# next update, with no change here. Editing THIS file, by contrast, only takes
# effect one release later — see docs/specs/UPDATES.md. Setup installs the
# backend's dependencies (the tree ships without node_modules), renders
# wisp.service, and refreshes the privileged wisp-* helpers — this script and
# wisp-updater.service among them, by atomic rename, so the running inode
# finishes this update. It runs under the lock taken above (fd 8).
SETUP="$INSTALL_DIR/scripts/linux/setup/common-steps.sh"
[[ -x "$SETUP" ]] || fail "missing $SETUP — releases older than v2.0.2 cannot be installed by this updater"
host_setup_touched=1
run_child 0 own-bound "$SETUP" "$INSTALL_DIR" "$DEPLOY_USER" || fail "setup failed"
run_child "$DAEMON_RELOAD_SEC" "$KILL_GRACE_SEC" systemctl daemon-reload || fail "daemon-reload failed"

echo "step:start-service"
# Blocks until the new backend is ready or has failed (Type=notify; bounded by
# the unit's TimeoutStartSec, inside this unit's own).
START_TS="$(date +%s)"
if ! run_child 0 "$KILL_GRACE_SEC" systemctl start "$SERVICE_UNIT"; then
  run_child "$STATUS_SEC" "$KILL_GRACE_SEC" journalctl --sync 2>/dev/null || true
  run_child "$STATUS_SEC" "$KILL_GRACE_SEC" journalctl -u "$SERVICE_UNIT" --since "@$START_TS" -n 20 --no-pager -o cat 2>/dev/null \
    | sed 's/^/  wisp: /' || true
  fail "new release did not start"
fi

# Drop staging + target marker after a successful swap. <install>.prev is kept
# until the next successful update for one-deep manual rollback.
rm -rf "$STAGING" || true
rm -f "$TARGET_FILE" || true

echo "step:done"
trap - EXIT
exit 0
