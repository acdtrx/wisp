#!/usr/bin/env bash
# Usage: wisp-power shutdown | reboot
# The host's power actions, for Host → Power. Run through sudo by the backend.
# shellcheck source=wisp-helper-lib.sh
source "${BASH_SOURCE[0]%/*}/wisp-helper-lib.sh"

(( $# == 1 )) || refuse "usage: wisp-power shutdown|reboot"
match_one_of "the action" "$1" shutdown reboot

case "$1" in
  shutdown) must "$QUICK_SEC" shutdown -h now >/dev/null ;;
  reboot) must "$QUICK_SEC" shutdown -r now >/dev/null ;;
esac
