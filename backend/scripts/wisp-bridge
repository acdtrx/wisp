#!/usr/bin/env bash
# Usage:
#   wisp-bridge create <base-bridge> <vlan-id>
#   wisp-bridge delete <base-bridge> <vlan-id>
#
# A VLAN-tagged bridge on a host bridge, for Host → Network: the VLAN interface
# <base>.<id> on <base>, and the bridge <base>-vlan<id> holding it, in a netplan
# file of Wisp's own (/etc/netplan/91-wisp-vlan__<base>__<id>__<bridge>.yaml),
# then `netplan apply`. Names and the file are derived from the two arguments;
# netplan files that are not Wisp's are never touched.
# shellcheck source=wisp-helper-lib.sh
source "${BASH_SOURCE[0]%/*}/wisp-helper-lib.sh"

readonly NETPLAN_DIR=/etc/netplan
readonly NETPLAN_APPLY_SEC=90

(( $# == 3 )) || refuse "usage: wisp-bridge create|delete <base-bridge> <vlan-id>"
match_one_of "the action" "$1" create delete
match "the base bridge" "$2" "$IFACE_RE"
[[ "$2" != *__* ]] || refuse "the base bridge must not contain '__': '$2'"
match "the VLAN id" "$3" '^[1-9][0-9]{0,3}$'
(( $3 <= 4094 )) || refuse "the VLAN id must be between 1 and 4094: '$3'"
BASE="$2"
VLAN_ID="$3"
BRIDGE="${BASE}-vlan${VLAN_ID}"
VLAN_IFACE="${BASE}.${VLAN_ID}"
(( ${#BRIDGE} <= 15 )) || refuse "the bridge name $BRIDGE is longer than an interface name may be (15)"
(( ${#VLAN_IFACE} <= 15 )) || refuse "the VLAN interface $VLAN_IFACE is longer than an interface name may be (15)"
FILE="$NETPLAN_DIR/91-wisp-vlan__${BASE}__${VLAN_ID}__${BRIDGE}.yaml"

is_vlanned_iface() {
  local iface="$1"
  [[ "$iface" =~ \.[0-9]+$ || "$iface" =~ -vlan[0-9]+$ ]] && return 0
  [[ -f /proc/net/vlan/config ]] \
    && awk -v iface="$iface" -F ' \\| ' '$1 == iface { found = 1 } END { exit(found ? 0 : 1) }' /proc/net/vlan/config
}

bridge_has_non_vlan_member() {
  local member
  for member in "/sys/class/net/$1/brif"/*; do
    [[ -e "$member" ]] || continue
    is_vlanned_iface "${member##*/}" || return 0
  done
  return 1
}

create() {
  [[ -d "/sys/class/net/$BASE/bridge" ]] || not_found "$BASE is not a bridge on this host"
  ! is_vlanned_iface "$BASE" || refuse "$BASE is VLAN-tagged, so it cannot hold a VLAN bridge"
  bridge_has_non_vlan_member "$BASE" || refuse "$BASE has no member that is not VLAN-tagged"
  local tmp
  capture "$QUICK_SEC" mktemp "$FILE.wisp-new.XXXXXX" || fail "cannot create a file in $NETPLAN_DIR${BOUNDED_ERR:+: $BOUNDED_ERR}"
  tmp="$CAPTURED"
  cat > "$tmp" <<YAML
# Managed by Wisp. Do not edit manually.
network:
  version: 2
  vlans:
    ${VLAN_IFACE}:
      id: ${VLAN_ID}
      link: ${BASE}
  bridges:
    ${BRIDGE}:
      interfaces: [${VLAN_IFACE}]
      parameters:
        stp: false
        forward-delay: 0
YAML
  must "$QUICK_SEC" chmod 600 -- "$tmp"
  must "$QUICK_SEC" mv -fT -- "$tmp" "$FILE"
  must "$NETPLAN_APPLY_SEC" netplan apply
}

# The links go before netplan forgets them: `netplan apply` leaves a bridge it
# no longer defines in place.
delete() {
  [[ -e "$FILE" || -d "/sys/class/net/$BRIDGE" || -d "/sys/class/net/$VLAN_IFACE" ]] \
    || not_found "no VLAN bridge $BRIDGE"
  must "$QUICK_SEC" rm -f -- "$FILE"
  if [[ -L "/sys/class/net/$VLAN_IFACE/master" ]]; then
    bounded "$QUICK_SEC" ip link set "$VLAN_IFACE" nomaster || true
  fi
  [[ ! -d "/sys/class/net/$BRIDGE" ]] || bounded "$QUICK_SEC" ip link del "$BRIDGE" || true
  [[ ! -d "/sys/class/net/$VLAN_IFACE" ]] || bounded "$QUICK_SEC" ip link del "$VLAN_IFACE" || true
  must "$NETPLAN_APPLY_SEC" netplan apply
}

"$1"
