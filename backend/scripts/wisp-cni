#!/usr/bin/env bash
# Usage:
#   wisp-cni add <container> <bridge> <mac>
#   wisp-cni del <container> <bridge>
#
# A container's port on a host bridge, through the CNI bridge plugin with DHCP
# addressing (docs/specs/CONTAINERS.md, Networking). The answer is the plugin's
# CNI result, JSON on stdout (none for a del).
#
# Every input is data this helper checks: the container's name, which also
# names its network namespace (always Wisp's own, /var/run/netns/<container>),
# the bridge and the MAC address. The network configuration is written here,
# from them and fixed settings; the plugins are the ones setup installs in
# /opt/cni/bin.
# shellcheck source=wisp-helper-lib.sh
source "${BASH_SOURCE[0]%/*}/wisp-helper-lib.sh"

readonly CNI_BIN_DIR=/opt/cni/bin
readonly NETNS_DIR=/var/run/netns
# An add waits for the DHCP daemon's lease.
readonly CNI_SEC=25

usage="usage: wisp-cni add <container> <bridge> <mac> | del <container> <bridge>"
(( $# >= 3 )) || refuse "$usage"
match_one_of "the action" "$1" add del
case "$1" in
  add) (( $# == 4 )) || refuse "$usage" ;;
  del) (( $# == 3 )) || refuse "$usage" ;;
esac
match_name "the container" "$2"
match "the bridge" "$3" "$IFACE_RE"
[[ "$1" == del ]] || match "the MAC address" "$4" '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'
NAME="$2"
BRIDGE="$3"
NETNS="$NETNS_DIR/$NAME"

PLUGIN="$CNI_BIN_DIR/bridge"
[[ -f "$PLUGIN" && -x "$PLUGIN" ]] || fail "the CNI bridge plugin $PLUGIN is not installed: run setup"
if [[ "$1" == add ]]; then
  [[ -d "/sys/class/net/$BRIDGE/bridge" ]] || not_found "$BRIDGE is not a bridge on this host"
  [[ -e "$NETNS" ]] || not_found "no network namespace $NAME"
fi

# Wisp's network: the settings below, the same for every container; the DHCP
# daemon keys its leases by the network's name and the container's.
MAC_ARGS=""
[[ "$1" == del ]] || MAC_ARGS=",\"args\":{\"cni\":{\"mac\":\"$4\"}}"
NETCONF="{\"cniVersion\":\"1.0.0\",\"name\":\"wisp-bridge\",\"type\":\"bridge\",\"bridge\":\"$BRIDGE\",\"isGateway\":false,\"isDefaultGateway\":false,\"ipMasq\":false,\"hairpinMode\":false,\"promiscMode\":false,\"forceAddress\":false,\"ipam\":{\"type\":\"dhcp\"}$MAC_ARGS}"

case "$1" in
  add) CNI_COMMAND=ADD ;;
  del) CNI_COMMAND=DEL ;;
esac
export CNI_COMMAND CNI_CONTAINERID="$NAME" CNI_NETNS="$NETNS" CNI_IFNAME=eth0 CNI_PATH="$CNI_BIN_DIR"

rc=0
capture "$CNI_SEC" "$PLUGIN" <<<"$NETCONF" || rc=$?
(( rc == 124 )) && fail "the bridge plugin's $CNI_COMMAND did not finish within ${CNI_SEC} s"
# A plugin's error is a JSON object on stdout, its log on stderr.
(( rc == 0 )) || fail "the bridge plugin's $CNI_COMMAND failed (exit $rc): ${CAPTURED//$'\n'/ }${BOUNDED_ERR:+; $BOUNDED_ERR}"
[[ -z "$CAPTURED" ]] || printf '%s\n' "$CAPTURED"
