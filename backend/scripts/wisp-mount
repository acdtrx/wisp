#!/usr/bin/env bash
# Usage:
#   wisp-mount smb mount    <configPath>
#   wisp-mount smb check    <configPath>
#   wisp-mount disk mount   <configPath>
#   wisp-mount unmount      <mountPath under /mnt/wisp/>   # refused unless it is a mount point
#   wisp-mount unmount-lazy <mountPath under /mnt/wisp/>
#   wisp-mount rmdir        <mountPath under /mnt/wisp/>   # delete-only cleanup; no-op if non-empty or missing
#
# Config file format (one key=value per line; '#' comments and blank lines ignored):
#   SMB:  share, mountPath, credentialsPath, uid, gid
#   Disk: uuid, mountPath, fsType, readOnly (0|1), uid, gid
#
# The SMB `credentialsPath` points at a separate mode-0600 file in the standard
# mount.cifs format (`username=...` / `password=...` / `domain=...`), passed to
# the kernel via `mount -o credentials=<path>` so secrets never appear on argv
# (`/proc/<pid>/cmdline`) or in this script's environment. The JS caller
# (smbMount.js) writes both files in a temp dir and unlinks them after the
# helper returns.
#
# Parsing the config file uses a strict allow-listed key=value parser — never
# `source`. Any unknown key, multi-line value, or value containing a literal
# newline is rejected. This stops a JS-side regression from turning the helper
# into a `bash -e` primitive.
#
# Install: sudoers NOPASSWD for this script (installed by scripts/linux/setup/install-helpers.sh).
set -euo pipefail

CMD="${1:-}"
SUB="${2:-}"
ARG="${3:-}"

SUPPORTED_DISK_FSTYPES=(ext4 btrfs vfat exfat ntfs3)
WISP_MOUNT_ROOT="/mnt/wisp"

is_supported_fstype() {
  local t="$1"
  for x in "${SUPPORTED_DISK_FSTYPES[@]}"; do
    [[ "$x" == "$t" ]] && return 0
  done
  return 1
}

# Defense in depth: refuse to mount over anything outside /mnt/wisp/. The JS
# caller already validates this; if it ever regresses, this block stops the
# helper from shadowing /etc, /usr, /home, etc.
assert_mount_path_under_wisp() {
  local p="$1"
  if [[ -z "$p" || "${p:0:1}" != "/" ]]; then
    echo "mountPath must be an absolute path" >&2
    exit 64
  fi
  local resolved
  resolved="$(realpath -m -- "$p")"
  case "$resolved" in
    "${WISP_MOUNT_ROOT}/"*) : ;;
    *)
      echo "mountPath must be under ${WISP_MOUNT_ROOT}/ (got ${resolved})" >&2
      exit 64
      ;;
  esac
}

# Refuse a path any existing component of which is a symlink. The deploy user
# owns /mnt/wisp, so a symlink planted inside it is the way to point a root
# mkdir/mount somewhere else.
assert_no_symlink_components() {
  local p="$1" rest comp prefix=""
  rest="${p#/}"
  while [[ -n "$rest" ]]; do
    comp="${rest%%/*}"
    if [[ "$rest" == */* ]]; then rest="${rest#*/}"; else rest=""; fi
    [[ -z "$comp" ]] && continue
    prefix="${prefix}/${comp}"
    if [[ -L "$prefix" ]]; then
      echo "mountPath must not contain symlinks (${prefix})" >&2
      exit 64
    fi
  done
}

# Validate, create, then re-validate the mount point and set MOUNT_TARGET to
# its canonical path. The second check sits right before mount(8) so a
# component swapped for a symlink after the first check (but before mkdir -p
# or mount follow it) is caught.
prepare_mount_point() {
  local p="$1"
  assert_mount_path_under_wisp "$p"
  assert_no_symlink_components "$p"
  mkdir -p -- "$p"
  assert_no_symlink_components "$p"
  MOUNT_TARGET="$(realpath -e -- "$p")"
  case "$MOUNT_TARGET" in
    "${WISP_MOUNT_ROOT}/"*) : ;;
    *)
      echo "mountPath must be under ${WISP_MOUNT_ROOT}/ (got ${MOUNT_TARGET})" >&2
      exit 64
      ;;
  esac
}

# Resolve an unmount/rmdir target without stat-ing its last component: on a
# dead CIFS share that stat blocks until the server times out, which is the
# case `unmount-lazy` exists for (umount -l itself avoids the stat). The parent
# goes through realpath, so a symlinked ancestor is resolved before the
# /mnt/wisp check; the last component is a plain name. Sets TARGET_PATH;
# returns 1 when the parent does not exist (nothing there to act on).
resolve_wisp_child() {
  local p="$1" parent base parent_resolved
  if [[ -z "$p" || "${p:0:1}" != "/" ]]; then
    echo "mountPath must be an absolute path" >&2
    exit 64
  fi
  while [[ "$p" == */ && "$p" != "/" ]]; do p="${p%/}"; done
  base="${p##*/}"
  parent="${p%/*}"
  if [[ -z "$base" || "$base" == "." || "$base" == ".." ]]; then
    echo "mountPath must name a directory under ${WISP_MOUNT_ROOT}/" >&2
    exit 64
  fi
  parent_resolved="$(realpath -e -- "${parent:-/}" 2>/dev/null)" || return 1
  case "$parent_resolved" in
    "$WISP_MOUNT_ROOT"|"${WISP_MOUNT_ROOT}/"*) : ;;
    *)
      echo "mountPath must be under ${WISP_MOUNT_ROOT}/ (got ${parent_resolved%/}/${base})" >&2
      exit 64
      ;;
  esac
  TARGET_PATH="${parent_resolved%/}/${base}"
}

# True when $1 is a mount target in /proc/self/mounts. The kernel lists
# canonical paths (never a symlink) with space, tab, newline and backslash
# octal-escaped; escape ours the same way and compare whole fields.
is_mount_target() {
  local want="" c i dev target rest
  for (( i = 0; i < ${#1}; i++ )); do
    c="${1:i:1}"
    case "$c" in
      ' ') want+='\040' ;;
      $'\t') want+='\011' ;;
      $'\n') want+='\012' ;;
      '\') want+='\134' ;;
      *) want+="$c" ;;
    esac
  done
  while read -r dev target rest; do
    [[ "$target" == "$want" ]] && return 0
  done < /proc/self/mounts
  return 1
}

# Unmount TARGET_PATH only if it is a mount point; message matches umount's
# own so the backend's "not mounted" handling still applies.
unmount_wisp_child() {
  if ! resolve_wisp_child "$1" || ! is_mount_target "$TARGET_PATH"; then
    echo "wisp-mount: $1: not mounted" >&2
    exit 32
  fi
  shift
  umount "$@" -- "$TARGET_PATH"
}

# Strict key=value parser. Reads a config file line by line, splits on the
# first '=', and only assigns to known keys. Rejects unknown keys with exit 64.
# Variables are written via `printf -v` so values stay literal (no $-expansion,
# no command substitution, no glob expansion).
read_smb_config() {
  share=""
  mountPath=""
  credentialsPath=""
  uid=""
  gid=""
  local line k v
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      \#*|'') continue ;;
      *=*)
        k="${line%%=*}"
        v="${line#*=}"
        case "$k" in
          share|mountPath|credentialsPath|uid|gid)
            printf -v "$k" '%s' "$v"
            ;;
          *)
            echo "wisp-mount: unknown config key: $k" >&2
            exit 64
            ;;
        esac
        ;;
      *)
        echo "wisp-mount: malformed config line" >&2
        exit 64
        ;;
    esac
  done < "$1"
}

read_disk_config() {
  uuid=""
  mountPath=""
  fsType=""
  readOnly=""
  uid=""
  gid=""
  local line k v
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      \#*|'') continue ;;
      *=*)
        k="${line%%=*}"
        v="${line#*=}"
        case "$k" in
          uuid|mountPath|fsType|readOnly|uid|gid)
            printf -v "$k" '%s' "$v"
            ;;
          *)
            echo "wisp-mount: unknown config key: $k" >&2
            exit 64
            ;;
        esac
        ;;
      *)
        echo "wisp-mount: malformed config line" >&2
        exit 64
        ;;
    esac
  done < "$1"
}

do_smb_mount() {
  read_smb_config "$1"
  if [[ -z "${mountPath:-}" || -z "${share:-}" ]]; then
    echo "Config must set mountPath and share" >&2
    exit 1
  fi
  if [[ -z "${credentialsPath:-}" || ! -f "$credentialsPath" ]]; then
    echo "Config must set credentialsPath pointing to a readable file" >&2
    exit 1
  fi
  local opts="rw,credentials=${credentialsPath}"
  [[ -n "${uid:-}" ]] && opts="${opts},uid=${uid}"
  [[ -n "${gid:-}" ]] && opts="${opts},gid=${gid}"
  prepare_mount_point "$mountPath"
  mount -t cifs "$share" "$MOUNT_TARGET" -o "$opts"
}

do_smb_check() {
  do_smb_mount "$1"
  umount -- "$MOUNT_TARGET"
  rmdir -- "$MOUNT_TARGET"
}

do_disk_mount() {
  read_disk_config "$1"
  if [[ -z "${mountPath:-}" || -z "${uuid:-}" || -z "${fsType:-}" ]]; then
    echo "Config must set mountPath, uuid, and fsType" >&2
    exit 1
  fi
  assert_mount_path_under_wisp "$mountPath"
  if ! is_supported_fstype "$fsType"; then
    echo "Unsupported fsType: $fsType" >&2
    exit 1
  fi
  local devPath="/dev/disk/by-uuid/$uuid"
  if [[ ! -e "$devPath" ]]; then
    echo "Device not present: $devPath" >&2
    exit 1
  fi
  local opts=""
  local ro=""
  [[ "${readOnly:-0}" == "1" ]] && ro="ro"
  # ntfs3 forced to ro by the backend; enforce here too.
  [[ "$fsType" == "ntfs3" ]] && ro="ro"

  case "$fsType" in
    vfat|exfat|ntfs3)
      opts=""
      [[ -n "$ro" ]] && opts="${opts},${ro}"
      [[ -n "${uid:-}" ]] && opts="${opts},uid=${uid}"
      [[ -n "${gid:-}" ]] && opts="${opts},gid=${gid}"
      opts="${opts},umask=0007"
      ;;
    ext4|btrfs)
      opts="defaults"
      [[ -n "$ro" ]] && opts="${opts},${ro}"
      ;;
  esac
  opts="${opts#,}"
  prepare_mount_point "$mountPath"
  mount -t "$fsType" "$devPath" "$MOUNT_TARGET" -o "$opts"
}

case "$CMD" in
  smb)
    if [[ -z "$ARG" || ! -f "$ARG" ]]; then
      echo "Usage: $0 smb mount|check <configPath>" >&2
      exit 1
    fi
    case "$SUB" in
      mount) do_smb_mount "$ARG"; rm -f "$ARG" ;;
      check) do_smb_check "$ARG"; rm -f "$ARG" ;;
      *) echo "Usage: $0 smb mount|check <configPath>" >&2; exit 1 ;;
    esac
    ;;
  disk)
    if [[ "$SUB" != "mount" ]]; then
      echo "Usage: $0 disk mount <configPath>" >&2
      exit 1
    fi
    if [[ -z "$ARG" || ! -f "$ARG" ]]; then
      echo "Usage: $0 disk mount <configPath>" >&2
      exit 1
    fi
    do_disk_mount "$ARG"
    rm -f "$ARG"
    ;;
  unmount)
    if [[ -z "$SUB" ]]; then
      echo "Usage: $0 unmount <mountPath under ${WISP_MOUNT_ROOT}/>" >&2
      exit 1
    fi
    unmount_wisp_child "$SUB"
    ;;
  unmount-lazy)
    if [[ -z "$SUB" ]]; then
      echo "Usage: $0 unmount-lazy <mountPath under ${WISP_MOUNT_ROOT}/>" >&2
      exit 1
    fi
    unmount_wisp_child "$SUB" -l
    ;;
  rmdir)
    # Delete-flow cleanup only: removes an empty directory under /mnt/wisp/.
    # rmdir(2) does not follow a symlink in the last component, and a mounted
    # or non-empty directory just fails (ignored).
    if [[ -z "$SUB" ]]; then
      echo "Usage: $0 rmdir <mountPath under ${WISP_MOUNT_ROOT}/>" >&2
      exit 1
    fi
    resolve_wisp_child "$SUB" || exit 0
    rmdir -- "$TARGET_PATH" 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 smb mount|check <configPath> | disk mount <configPath> | unmount <mountPath> | unmount-lazy <mountPath> | rmdir <mountPath>" >&2
    exit 1
    ;;
esac
