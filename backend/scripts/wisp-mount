#!/usr/bin/env bash
# Usage:
#   wisp-mount smb-mount  <share> <mount-path> <credentials-file|guest> <owner-only|shared>
#   wisp-mount smb-check  <share> <mount-path> <credentials-file|guest>
#   wisp-mount disk-mount <uuid> <mount-path> <fstype> <ro|rw>
#   wisp-mount unmount      <mount-path>   # exit 2 unless it is a mount point
#   wisp-mount unmount-lazy <mount-path>
#   wisp-mount rmdir        <mount-path>   # the delete flow's: an empty, unmounted folder
#
# SMB shares and adopted removable disks under /mnt/wisp (docs/specs/STORAGE.md,
# Privileged helper). Every mount is nosuid,nodev: a disk or a share carries
# data Wisp does not control, never a setuid program or a device file for the
# host. uid and gid are the invoking user's (SUDO_UID, SUDO_GID).
#
# SMB credentials never appear on argv: the backend writes them in a 0600 file
# of its own, in mount.cifs's format, and passes its path; `guest` mounts with
# no credentials at all.
#
# A mount path is canonical, strictly under /mnt/wisp, and no part of it below
# /mnt/wisp is a symbolic link: the deploy user owns /mnt/wisp, so a link
# planted there is the way to point a root mkdir or mount somewhere else. A
# mount checks it before mkdir and again right before mount(8).
# shellcheck source=wisp-helper-lib.sh
source "${BASH_SOURCE[0]%/*}/wisp-helper-lib.sh"

readonly MOUNT_ROOT=/mnt/wisp
FSTYPES=(ext4 btrfs vfat exfat ntfs3)

# Each ends, with its kill grace, inside the backend's own bound
# (docs/specs/STORAGE.md, Timeouts): mount 20 s; unmount 60 s, long enough to
# flush after a large backup; an smb check's mount 15 s and its umount 8 s (it
# writes nothing to flush).
readonly MOUNT_SEC=20
readonly UMOUNT_SEC=60
readonly CHECK_MOUNT_SEC=15
readonly CHECK_UMOUNT_SEC=8

usage="usage: wisp-mount smb-mount <share> <mount-path> <credentials-file|guest> <owner-only|shared> | smb-check <share> <mount-path> <credentials-file|guest> | disk-mount <uuid> <mount-path> <fstype> <ro|rw> | unmount|unmount-lazy|rmdir <mount-path>"
(( $# >= 2 )) || refuse "$usage"
match_one_of "the action" "$1" smb-mount smb-check disk-mount unmount unmount-lazy rmdir
ACTION="$1"
shift
case "$ACTION" in
  smb-mount) (( $# == 4 )) || refuse "$usage" ;;
  smb-check) (( $# == 3 )) || refuse "$usage" ;;
  disk-mount) (( $# == 4 )) || refuse "$usage" ;;
  *) (( $# == 1 )) || refuse "$usage" ;;
esac

# mount_path_arg <path>: canonical and strictly under /mnt/wisp.
mount_path_arg() {
  canonical_path "the mount path" "$1"
  [[ "$1" == "$MOUNT_ROOT"/?* ]] || refuse "the mount path must be under $MOUNT_ROOT/: '$1'"
}

# share_arg <share>: //host/share[/path]: no leading `-`, no comma, no control
# character.
share_arg() {
  match "the share" "$1" '^//[A-Za-z0-9._-]+(/[^/,[:cntrl:]]+)+$'
}

# credentials_arg <file|guest>: CREDENTIALS, the mount option for it.
credentials_arg() {
  if [[ "$1" == guest ]]; then
    CREDENTIALS=guest
    return 0
  fi
  match "the credentials file" "$1" '^/[A-Za-z0-9._/-]+$'
  canonical_path "the credentials file" "$1"
  [[ -f "$1" && ! -L "$1" ]] || refuse "the credentials file must be a regular file: '$1'"
  capture "$QUICK_SEC" stat -c %u -- "$1" || fail "cannot read the owner of $1${BOUNDED_ERR:+: $BOUNDED_ERR}"
  [[ "$CAPTURED" == "$INVOKER_UID" ]] || refuse "the credentials file must be the invoking user's (uid $INVOKER_UID): '$1'"
  CREDENTIALS="credentials=$1"
}

# prepare_mount_point <path>: checked, made, checked again.
prepare_mount_point() {
  path_under "the mount path" "$1" "$MOUNT_ROOT"
  must "$QUICK_SEC" mkdir -p -- "$1"
  path_under "the mount path" "$1" "$MOUNT_ROOT"
}

# True when $1 is a mount target in /proc/self/mounts. The kernel lists
# canonical paths (never a symlink) with space, tab, newline and backslash
# octal-escaped; escape ours the same way and compare whole fields.
is_mount_target() {
  local want="" c i target rest
  for (( i = 0; i < ${#1}; i++ )); do
    c="${1:i:1}"
    case "$c" in
      ' ') want+='\040' ;;
      $'\t') want+='\011' ;;
      $'\n') want+='\012' ;;
      \\) want+='\134' ;;
      *) want+="$c" ;;
    esac
  done
  while read -r _ target rest; do
    [[ "$target" == "$want" ]] && return 0
  done < /proc/self/mounts
  return 1
}

# The last part of an unmount's or rmdir's path is never looked at: on a dead
# share that blocks until the server times out, the case unmount-lazy is for.
# The parts above it are checked like a mount's.
check_parent() {
  local parent="${1%/*}"
  [[ "$parent" == "$MOUNT_ROOT" ]] || path_under "the mount path" "$parent" "$MOUNT_ROOT"
}

smb_mount() { # <share> <path> <credentials> <secs> [owner-only]
  local opts="nosuid,nodev,uid=$INVOKER_UID,gid=$INVOKER_GID,$3"
  # owner-only (the backup destination): CIFS without Unix extensions shows one
  # mode for the whole mount and ignores chmod, so it is set here.
  [[ "${5:-}" != owner-only ]] || opts+=",file_mode=0600,dir_mode=0700"
  prepare_mount_point "$2"
  must "$4" mount -t cifs -o "$opts" -- "$1" "$2"
}

case "$ACTION" in
  smb-mount)
    share_arg "$1"
    mount_path_arg "$2"
    invoking_user
    credentials_arg "$3"
    match_one_of "the mode" "$4" owner-only shared
    smb_mount "$1" "$2" "$CREDENTIALS" "$MOUNT_SEC" "$4"
    ;;
  smb-check)
    share_arg "$1"
    mount_path_arg "$2"
    invoking_user
    credentials_arg "$3"
    CHECK_POINT="$2"
    # The check's mount point goes, whether the mount worked or not; rmdir
    # refuses a folder still mounted on.
    trap 'bounded "$QUICK_SEC" rmdir -- "$CHECK_POINT" || true' EXIT
    smb_mount "$1" "$2" "$CREDENTIALS" "$CHECK_MOUNT_SEC"
    must "$CHECK_UMOUNT_SEC" umount -- "$2"
    ;;
  disk-mount)
    match "the UUID" "$1" '^[0-9A-Fa-f][0-9A-Fa-f-]{0,63}$'
    mount_path_arg "$2"
    match_one_of "the file system" "$3" "${FSTYPES[@]}"
    match_one_of "the access" "$4" ro rw
    invoking_user
    DEVICE="/dev/disk/by-uuid/$1"
    [[ -b "$DEVICE" ]] || not_found "no disk with UUID $1"
    opts="nosuid,nodev"
    case "$3" in
      vfat | exfat | ntfs3) opts+=",uid=$INVOKER_UID,gid=$INVOKER_GID,umask=0007" ;;
    esac
    # ntfs3 is mounted read-only whatever was asked.
    [[ "$4" == rw && "$3" != ntfs3 ]] || opts+=",ro"
    prepare_mount_point "$2"
    must "$MOUNT_SEC" mount -t "$3" -o "$opts" -- "$DEVICE" "$2"
    ;;
  unmount | unmount-lazy)
    mount_path_arg "$1"
    check_parent "$1"
    is_mount_target "$1" || not_found "$1 is not mounted"
    if [[ "$ACTION" == unmount-lazy ]]; then
      must "$UMOUNT_SEC" umount -l -- "$1"
    else
      must "$UMOUNT_SEC" umount -- "$1"
    fi
    ;;
  rmdir)
    mount_path_arg "$1"
    check_parent "$1"
    ! is_mount_target "$1" || fail "$1 is still mounted"
    [[ -d "$1" && ! -L "$1" ]] || not_found "no folder $1"
    must "$QUICK_SEC" rmdir -- "$1"
    ;;
esac
