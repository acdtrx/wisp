{
  "route": "GET /api/containers/:name/mounts/usage",
  "status": 200,
  "body": {
    "mounts": [
      {
        "containerPath": "/srv",
        "hostPath": "/var/lib/wisp/containers/ct-a/files/srv",
        "name": "srv",
        "partial": false,
        "sizeBytes": 8000,
        "source": "local",
        "type": "directory"
      },
      {
        "containerPath": "/etc/caddy/Caddyfile",
        "hostPath": "/var/lib/wisp/containers/ct-a/files/Caddyfile",
        "name": "Caddyfile",
        "partial": false,
        "sizeBytes": 64,
        "source": "local",
        "type": "file"
      }
    ],
    "name": "ct-a"
  }
}
